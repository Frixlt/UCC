#!/usr/bin/make -f
# -*- makefile -*-

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
RUST_TARGET_DIR = $(CURDIR)/target/deb

%:
	dh $@ -Scmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DBUILD_GUI=ON \
		-DBUILD_TRAY=OFF \
		-DBUILD_GNOME=ON \
		-DBUILD_CLI=OFF \
		-DUCC_PACKAGE_RUST_RUNTIME=ON

override_dh_auto_build:
	dh_auto_build
	cargo build --workspace --release --locked --offline --bins --target-dir "$(RUST_TARGET_DIR)"

override_dh_auto_install:
	dh_auto_install --destdir=$(CURDIR)/debian/tmp
	"$(RUST_TARGET_DIR)/release/xtask" install-runtime debian/tmp/usr "$(RUST_TARGET_DIR)/release"
	# Create configuration directory
	mkdir -p debian/tmp/etc/ucc
	chmod 755 debian/tmp/etc/ucc

override_dh_installsystemd:
	dh_installsystemd --name=uccd
