_reload_udev() {
	if [ -d /run/systemd/system ] && command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload-rules || true
		udevadm trigger --subsystem-match=misc --sysname-match=uwcc || true
		udevadm trigger --subsystem-match=hidraw || true
	fi
}

post_install() {
	_reload_udev
}

post_upgrade() {
	_reload_udev
}

post_remove() {
	_reload_udev
}
