[Unit]
Description=Preserve UCCD runtime settings across system sleep
Documentation=man:uccd(8)
DefaultDependencies=no
Before=sleep.target nvidia-suspend.service nvidia-hibernate.service
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/ucc/ucc-sleep prepare
# Also recover when preparing sleep failed after the daemon was stopped.
ExecStopPost=/usr/lib/ucc/ucc-sleep resume
TimeoutStartSec=60s
TimeoutStopSec=30s
User=root
UMask=0077

[Install]
RequiredBy=sleep.target
