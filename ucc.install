## arg 1: new package version

post_install() {
  systemctl daemon-reload
  echo ":: Enable uccd.service and uccd-sleep.service after installing the hardware driver."
  echo ":: Read /usr/share/doc/ucc/PROJECT_ORIGINS.md before replacing an existing controller."
}

# Older local packages owned a private backup-marked /etc/ucc/settings.
# Preserve it while switching to a public package that owns no personal settings.
ucc_preserve_settings() {
  local package_root="${1:-}"
  rm -f "$package_root/var/lib/ucc/package-upgrade/pending"
  if [ -f "$package_root/etc/ucc/settings" ] && [ ! -L "$package_root/etc/ucc/settings" ]; then
    install -d -m 0700 "$package_root/var/lib/ucc/package-upgrade"
    install -m 0600 "$package_root/etc/ucc/settings" "$package_root/var/lib/ucc/package-upgrade/settings"
    touch "$package_root/var/lib/ucc/package-upgrade/pending"
  fi
}

ucc_restore_settings() {
  local package_root="${1:-}"
  if [ ! -e "$package_root/etc/ucc/settings" ] && [ ! -L "$package_root/etc/ucc/settings" ] &&
      [ -f "$package_root/var/lib/ucc/package-upgrade/settings" ] &&
      [ -f "$package_root/var/lib/ucc/package-upgrade/pending" ]; then
    install -d -m 0755 "$package_root/etc/ucc"
    install -m 0600 "$package_root/var/lib/ucc/package-upgrade/settings" "$package_root/etc/ucc/settings"
  fi
  rm -f "$package_root/var/lib/ucc/package-upgrade/pending"
}

pre_upgrade() {
  ucc_preserve_settings
}

# Optional root prefix lets packaging tests inspect a staged unit tree.
ucc_sleep_hook_enabled() {
  local sleep_state sleep_root sleep_target
  sleep_state=$(systemctl is-enabled uccd-sleep.service 2>/dev/null || true)
  case "$sleep_state" in
    enabled|enabled-runtime) return 0 ;;
    masked|masked-runtime) return 1 ;;
    *)
      # is-enabled on an alias succeeds even when its target is disabled.
      for sleep_root in "${1:-}/etc/systemd/system" "${1:-}/run/systemd/system"; do
        for sleep_target in suspend hibernate hybrid-sleep suspend-then-hibernate; do
          if [ -L "$sleep_root/$sleep_target.target.wants/uccd-pre-sleep.service" ]; then
            return 0
          fi
        done
      done
      ;;
  esac
  return 1
}

post_upgrade() {
  ucc_restore_settings
  systemctl daemon-reload
  # Replace old suspend-target links while preserving an explicitly disabled hook.
  if ucc_sleep_hook_enabled; then
    systemctl disable uccd-pre-sleep.service uccd-sleep.service 2>/dev/null || true
    systemctl enable uccd-sleep.service
  fi

  echo ":: Restart uccd and desktop clients when ready to use the upgraded version."

  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q usr/share/applications 2>/dev/null || true
}

pre_remove() {
  echo ":: Stopping uccd daemon..."
  systemctl stop uccd-sleep.service 2>/dev/null || true
  systemctl stop uccd.service 2>/dev/null || true

  echo ":: Disabling uccd services..."
  systemctl disable uccd.service 2>/dev/null || true
  systemctl disable uccd-pre-sleep.service uccd-sleep.service 2>/dev/null || true
}

post_remove() {
  systemctl daemon-reload

  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q usr/share/applications 2>/dev/null || true
}
