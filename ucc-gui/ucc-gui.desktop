[Desktop Entry]
Type=Application
Name=ucc-rusted
Comment=Hardware control, cooling profiles, power policies, and RGB lighting for Uniwill/Clevo/TUXEDO laptops
Comment[ru]=Управление питанием, охлаждением, СЖО и подсветкой для ноутбуков Uniwill/Clevo/TUXEDO
Exec=ucc-gui
Icon=ucc-gui
Terminal=false
Categories=System;Settings;Qt;
# A singleton launch may only activate an existing process, without completing
# the desktop's startup-notification transaction.
StartupNotify=false
# Ensure KDE associates running windows with this desktop file
StartupWMClass=ucc-gui
