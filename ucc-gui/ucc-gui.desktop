[Desktop Entry]
Type=Application
Name=Frixit Control Center
Comment=Frixit's ControlCenter combined with the native UCC Revorked suite
Comment[ru]=Объединение ControlCenter Frixit и UCC Revorked
Exec=ucc-gui
Icon=ucc-gui
Terminal=false
Categories=System;Settings;Qt;
# A singleton launch may only activate an existing process, without completing
# the desktop's startup-notification transaction.
StartupNotify=false
# Ensure KDE associates running windows with this desktop file
StartupWMClass=ucc-gui
