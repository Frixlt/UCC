@@ -168,6 +169,18 @@
         rm -rf "$BUILD_DIR"
         exit 1
     fi
+fi
+
+# Linux 7.3 removed struct acpi_driver; preserve all modules via platform drivers.
+if [ ! -f "$PATCH_EXACT_3" ]; then
+    echo "[ERROR] Missing Linux 7.3 compatibility patch: $PATCH_EXACT_3"
+    exit 1
+fi
+if patch --dry-run -p1 < "$PATCH_EXACT_3" >/dev/null 2>&1; then
+    patch -p1 < "$PATCH_EXACT_3" || exit 1
+elif ! patch --dry-run -R -p1 < "$PATCH_EXACT_3" >/dev/null 2>&1; then
+    echo "[ERROR] Linux 7.3 patch no longer matches upstream; retaining installed custom drivers."
+    exit 1
 fi
 
 # --- 3. ГЕНЕРАЦИЯ DKMS.CONF ИЗ KBUILD (без тестовой компиляции) ---
@@ -280,6 +293,7 @@
 # --- 5. СБОРКА И УСТАНОВКА ДЛЯ ВСЕХ ЯДЕР ---
 BUILT_ANY=0
 BUILT_KERNELS=""
+FAILED_KERNELS=""
 for kernel_dir in /lib/modules/*/build; do
     if [ ! -f "$kernel_dir/Makefile" ]; then
         continue
@@ -287,16 +301,18 @@
 
     kernelver=$(basename "$(dirname "$kernel_dir")")
     echo "-> Сборка для ядра: $kernelver"
-    if dkms build -m "$DKMS_MOD_NAME" -v "$DKMS_MOD_VERSION" -k "$kernelver"; then
+    if dkms build -j 1 -m "$DKMS_MOD_NAME" -v "$DKMS_MOD_VERSION" -k "$kernelver"; then
         if dkms install --no-depmod -m "$DKMS_MOD_NAME" -v "$DKMS_MOD_VERSION" -k "$kernelver" --force; then
             echo "   [OK] Установлено для $kernelver"
             BUILT_ANY=1
             BUILT_KERNELS="$BUILT_KERNELS $kernelver"
         else
             echo "   [WARN] dkms install провалился для $kernelver"
+            FAILED_KERNELS="$FAILED_KERNELS $kernelver"
         fi
     else
         echo "   [WARN] Не удалось собрать для $kernelver"
+        FAILED_KERNELS="$FAILED_KERNELS $kernelver"
         echo "   Лог: /var/lib/dkms/$DKMS_MOD_NAME/$DKMS_MOD_VERSION/$kernelver/x86_64/log/make.log"
     fi
 done
@@ -309,6 +325,11 @@
 
