--- a/update-tuxedo-worker.sh
+++ b/update-tuxedo-worker.sh
@@ -14,6 +14,7 @@
 SCRIPT_DIR="/home/frixit/.customconfigs/hooks/tuxedo"
 PATCH_EXACT_1="$SCRIPT_DIR/0001-exact-mechrevo-profile.patch"
 PATCH_EXACT_2="$SCRIPT_DIR/0002-linux-7-rgb-max-intensity.patch"
+PATCH_EXACT_3="$SCRIPT_DIR/0003-linux-7.3-acpi-lightbar.patch"
 PATCH_SCRIPT="$SCRIPT_DIR/apply_mechrevo_patches.sh"
 PATCH_PATH="$SCRIPT_DIR/mechrevo_clean.patch"
