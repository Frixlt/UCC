--- a/src/clevo_acpi.c
+++ b/src/clevo_acpi.c
@@ -23,6 +23,9 @@
 #include <linux/module.h>
 #include <linux/acpi.h>
 #include <linux/version.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+#include <linux/platform_device.h>
+#endif
 #include "clevo_interfaces.h"
 
 #define DRIVER_NAME			"clevo_acpi"
@@ -247,6 +250,50 @@
 	{"", 0}
 };
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+static void clevo_acpi_platform_notify(acpi_handle handle, u32 event, void *data)
+{
+	clevo_acpi_notify(data, event);
+}
+
+static int clevo_acpi_platform_probe(struct platform_device *pdev)
+{
+	struct acpi_device *adev = ACPI_COMPANION(&pdev->dev);
+	int err;
+
+	if (!adev)
+		return -ENODEV;
+	err = clevo_acpi_add(adev);
+	if (err)
+		return err;
+	err = acpi_dev_install_notify_handler(adev, ACPI_ALL_NOTIFY,
+					     clevo_acpi_platform_notify, adev);
+	if (err)
+		clevo_acpi_remove(adev);
+	return err;
+}
+
+static void clevo_acpi_platform_remove(struct platform_device *pdev)
+{
+	struct acpi_device *adev = ACPI_COMPANION(&pdev->dev);
+
+	acpi_dev_remove_notify_handler(adev, ACPI_ALL_NOTIFY, clevo_acpi_platform_notify);
+	clevo_acpi_remove(adev);
+}
+
+static struct platform_driver clevo_acpi_driver = {
+	.probe = clevo_acpi_platform_probe,
+	.remove = clevo_acpi_platform_remove,
+	.driver = {
+		.name = DRIVER_NAME,
+		.acpi_match_table = clevo_acpi_device_ids,
+#ifdef CONFIG_PM
+		.pm = &clevo_driver_pm_ops,
+#endif
+	},
+};
+module_platform_driver(clevo_acpi_driver);
+#else
 static struct acpi_driver clevo_acpi_driver = {
 	.name = DRIVER_NAME,
 	.class = DRIVER_NAME,
@@ -266,6 +313,7 @@
 };
 
 module_acpi_driver(clevo_acpi_driver);
+#endif
 
 MODULE_AUTHOR("TUXEDO Computers GmbH <tux@tuxedocomputers.com>");
 MODULE_DESCRIPTION("Driver for Clevo ACPI interface");
